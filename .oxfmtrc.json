{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "printWidth": 120,
  "overrides": [
    {
      "files": ["*.css", "**/*.css"],
      "options": {
        "singleQuote": false
      }
    }
  ],
  "ignorePatterns": ["README.md", "DESIGN.md", "docs/**", "src/components/ui/**"]
}
